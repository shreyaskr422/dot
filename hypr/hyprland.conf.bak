### ENVIRONMENT VARIABLES  ###

# Cursor and basic UI variables
env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24

# Optimization for AMD Vega iGPU
env = AMD_DEBUG,nogns
env = WLR_DRM_NO_ATOMIC,1

# Nvidia
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = GBM_BACKEND,nvidia-drm
env = LIBVA_DRIVER_NAME,nvidia
env = __GL_VRR_ALLOWED,1
env = __GL_GSYNC_ALLOWED,1
#env = __NV_PRIME_RENDER_OFFLOAD,1
#env = __NV_PRIME_RENDER_OFFLOAD_PROVIDER,NVIDIA-G0

# Wayland / Hyprland session
env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_DESKTOP,Hyprland
env = XDG_SESSION_TYPE,wayland

# Wayland backend compatibility layer
env = GDK_BACKEND,wayland,x11
env = SDL_VIDEODRIVER,wayland
env = CLUTTER_BACKEND,wayland

#QT APPS
env = QT_QPA_PLATFORM,wayland
env = QT_QPA_PLATFORMTHEME,qt6ct
env = QT_QPA_PLATFORMTHEME,qt5ct
env = QT_STYLE_OVERRIDE,kvantum
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1
env = QT_QPA_PLATFORMTHEME_QT6,qt6ct

#GTK APPS
env = GTK_THEME,WhiteSur-Dark-grey

#Electron Apps
env = ELECTRON_OZONE_PLATFORM_HINT,auto

# Chromium based browsers
env = CHROMIUM_FLAGS,--ozone-platform=wayland --enable-features=WaylandWindowDecorations

# Firefox
env = MOZ_ENABLE_WAYLAND,1
env = MOZ_DISABLE_RDD_SANDBOX,1

# Flatpak
env = XDG_DATA_DIRS,$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share


####MONITOR###

monitor=eDP-1,1920x1200@165,0x0,1
#monitor=HDMI-A-1,1920x1080@100,auto,auto
#monitor =eDP-1, disable

# https://wiki.hypr.land/Configuring/Variables/#input
input {
    kb_layout = us
    numlock_by_default = true
    repeat_rate = 60
    repeat_delay = 150
    follow_mouse = 1
    sensitivity = 0
    touchpad {
        natural_scroll = false
    }
}

gesture = 3, horizontal, workspace

device {
    name = epic-mouse-v1
    sensitivity = -0.5
}

cursor {
    inactive_timeout = 10
    no_hardware_cursors = false
}

### General compositor behavior ###

# noborders 
general {
    gaps_in = 5
    gaps_out = 7
    border_size = 0
    col.inactive_border = rgba(ffffffff)
    layout = dwindle
    resize_on_border = true
}

decoration {
    rounding = 14
    rounding_power = 4.0
    active_opacity = 1.0
    inactive_opacity = 1.0
   
  blur {
        enabled = no
        size = 8
        passes = 3
        noise = 0.02
        new_optimizations = on
        ignore_opacity = on
        xray = false
     } 

  shadow {
        enabled = false
        ignore_window = true
        offset = 0 0
        range = 30
        render_power = 3
        color = rgba(00000044)
    }
}

animations {
    enabled = false
    bezier = wind, 0.05, 0.9, 0.1, 1.05
    bezier = winIn, 0.1, 1.1, 0.1, 1.1
    bezier = winOut, 0.3, -0.3, 0, 1
    bezier = liner, 1, 1, 1, 1
    animation = windows, 1, 6, wind, slide
    animation = windowsIn, 1, 6, winIn, slide
    animation = windowsOut, 1, 5, winOut, slide
    animation = windowsMove, 1, 5, wind, slide
    animation = border, 1, 1, liner
    animation = borderangle, 1, 30, liner, loop
    animation = fade, 1, 10, default
    animation = workspaces, 1, 5, wind
}

# See https://wiki.hypr.land/Configuring/Dwindle-Layout/ for more
dwindle {
    pseudotile = true # Master switch for pseudotiling. Enabling is bound to mainMod + P in the keybinds section below
    preserve_split = true # You probably want this
    force_split = 0
}

# See https://wiki.hypr.land/Configuring/Master-Layout/ for more
master {
    new_status = master
}

# https://wiki.hypr.land/Configuring/Variables/#misc
misc {
    disable_hyprland_logo = true 
    force_default_wallpaper = 0
    vrr = 1
    vfr = true
}

xwayland {
    force_zero_scaling = true
}

layerrule = no_anim on, match:namespace ^(quickshell)$

#windowrule = suppressevent maximize, class:.*
windowrule {
    name = suppress-maximize-events
    match:class = .*
    suppress_event = maximize
}

# Fix some dragging issues with XWayland
windowrule {
    name = fix-xwayland-drags
    match:class = ^$
    match:title = ^$
    match:xwayland = true
    match:float = true
    match:fullscreen = false
    match:pin = false
    no_focus = true
}

# General system utilities that should always float
windowrule = float on, match:initial_class ^(nm-connection-editor|xdg-desktop-portal.*|pithos|org.quickshell|org.pulseaudio.pavucontrol)$
windowrule = float on, match:class ^(gnome-calculator|blueman-manager)$
windowrule = float on, match:title ^(Library|FontBase|KDE Connect URL handler)$
windowrule = size 1000 1050, match:class ^(org.quickshell)$, match:title ^(Settings)$
windowrule = center on, match:class ^(org.quickshell)$, match:title ^(Settings)$


# dialogs
windowrule = float on, match:initial_class ^(xdg-desktop-portal-.*)$
windowrule = float on, match:initial_title ^(?i)(Open|Save|Select|Upload|Choose|Enter|Confirm|Warning).*$
windowrule = center on, match:initial_title ^(?i)(Open|Save|Select|Upload|Choose|Enter).*$

# picture in picture
windowrule = float on, match:initial_title ^(Picture-in-Picture)$

# utilities
windowrule = float on, match:initial_class ^(org.pulseaudio.pavucontrol|nm-connection-editor)$
windowrule = center on, match:initial_class ^(org.pulseaudio.pavucontrol)$

#network manager
windowrule = float on, match:initial_class ^(nm-connection-editor)$

# Nautilus - File Browser (Force to WS 2)
windowrule = float on, match:initial_class ^(org.gnome.Nautilus)$
windowrule = size 852 548, match:initial_class ^(org.gnome.Nautilus)$
windowrule = center on, match:initial_class ^(org.gnome.Nautilus)$
windowrule = size 500 560, match:initial_class ^(org.gnome.Nautilus)$, match:initial_title ^.* - (Properties)$

# Brave windowrule
windowrule = float on, match:initial_class ^(brave-browser)$
windowrule = center on, match:initial_class ^(brave-browser)$
windowrule = persistent_size on, match:initial_class ^(brave-browser)$

# Firefox
windowrule = float on, match:class ^(firefox)$, match:title ^(Picture-in-Picture)$
windowrule = size 1100 780, match:initial_class ^(firefox)$

# System Audio Control
windowrule = size 1100 780, match:initial_class ^(org.pulseaudio.pavucontrol)$
windowrule = center on, match:initial_class ^(org.pulseaudio.pavucontrol)$

# Easyeffects
windowrule = float on, match:class ^(com.github.wwmm.easyeffects)$

# Kitty Dropdown (Scratchpad)
windowrule = float on, match:class ^(kitty-dropdown)$
windowrule = size 900 500, match:class ^(kitty-dropdown)$
windowrule = workspace special:dropdown, match:class ^(kitty-dropdown)$
windowrule = border_size 0, match:class ^(kitty-dropdown)$
windowrule = center on, match:class ^(kitty-dropdown)$
windowrule = opacity 0.60 override, match:initial_class ^(kitty-dropdown)$

# Forces specific applications to tile even if global behavior is floating
windowrule = tile on, match:class ^(org\.wezfurlong\.wezterm|gnome-control-center)$

# swayimg
windowrule = float on, match:initial_class ^(swayimg)$
windowrule = center on, match:initial_class ^(swayimg)$

# Qt6 Configuration Tool
windowrule = float on, match:initial_class ^(qt6ct)$
windowrule = size 614 901, match:initial_class ^(qt6ct)$
windowrule = center on, match:initial_class ^(qt6ct)$

# Portals & General File Pickers (Open/Save/Upload)
windowrule = float on, match:initial_class ^(xdg-desktop-portal-.*)$
windowrule = float on, match:initial_title ^(?i)(Open|Save|Select|Upload|Choose|Enter|Confirm|Warning).*$
windowrule = size 1100 700, match:initial_class ^(xdg-desktop-portal-.*)$
windowrule = size 1100 700, match:initial_title ^(?i)(Open|Save|Select|Upload|Choose|Enter).*$
windowrule = center on, match:initial_class ^(xdg-desktop-portal-.*)$
windowrule = center on, match:initial_title ^(?i)(Open|Save|Select|Upload|Choose|Enter).*$

# Smaller Dialogs (File Roller, Nautilus Rename, Appearance)
windowrule = float on, match:initial_class ^(org.gnome.FileaRoller|org.gnome.Nautilus|xfce4-appearance-settings)$
windowrule = size 350 150, match:initial_class ^(org.gnome.FileRoller|org.gnome.Nautilus)$, match:initial_title ^(File Roller|Rename).*$
windowrule = size 400 600, match:initial_class ^(xfce4-appearance-settings)$, match:initial_title ^(Appearance).*$
windowrule = center on, match:initial_class ^(org.gnome.FileRoller|org.gnome.Nautilus|xfce4-appearance-settings)$

# Opacity Overrides
windowrule = opacity 1.00 override, match:initial_class ^(gimp|swayimg)$
windowrule = opacity 0.90 override, match:initial_class ^(org.gnome.Nautilus)$
#windowrule = opacity 0.90 override, match:initial_class ^(YouTube Music Desktop App|YoutubeMusic|com.github.th_ch.youtube_music|)$
#windowrule = opacity 1.00 override, match:initial_class ^(Google-chrome|google-chrome)$

# Thunderbird - Compose, Alarms, & Progress
#windowrule = float on, match:class ^(org.mozilla.Thunderbird)$, match:title ^(Write:.*|Calendar Reminders|Edit Item|Sending Message - .*)$
#windowrule = size 1100 800, match:class ^(org.mozilla.Thunderbird)$, match:title ^(Write:.*|Calendar Reminders|Edit Item)$
#windowrule = size 450 150, match:initial_class ^(org.mozilla.Thunderbird)$, match:initial_title ^(Sending Message *)$
#windowrule = center on, match:class ^(org.mozilla.Thunderbird)$, match:title ^(Write:.*|Calendar Reminders|Edit Item|Sending Message - .*)$

# proton mail bridge RULES
#windowrule = float on, match:initial_class ^(proton-bridge)$
#windowrule = center on, match:initial_class ^(proton-bridge)$
#windowrule = size 1080 790, match:initial_class ^(proton-bridge)$

# zen windowrule
#windowrule = float on, match:initial_class ^(zen)$
#windowrule = center on, match:initial_class ^(zen)$
#windowrule = size 1900 1100, match:initial_class ^(zen)$

# Telegram
# windowrule = workspace 4, match:initial_class ^(org.telegram.desktop)$
#windowrule = float on, match:initial_class ^(org.telegram.desktop)$
#windowrule = size 420 540, match:initial_class ^(org.telegram.desktop)$
#windowrule = center on, match:initial_class ^(org.telegram.desktop)$

# scrcpy windowrule
#windowrule = float on, match:initial_class ^(scrcpy)$
#windowrule = center on, match:initial_class ^(scrcpy)$
#windowrule = size 495 1100, match:initial_class ^(scrcpy)$
#windowrule = opacity 1.00 override, match:initial_class ^(scrcpy)$

# Spotify - WINDOW RULES
#windowrule = float on, match:initial_title ^(Spotify Free)$
#windowrule = center on, match:initial_title ^(Spotify Free)$

# YouTubemusic windowrule
#windowrule = float on, match:initial_class ^(YouTube Music Desktop App|YoutubeMusic|com.github.th_ch.youtube_music)$
#windowrule = center on, match:initial_class ^(YouTube Music Desktop App|YoutubeMusic|com.github.th_ch.youtube_music)$

# Set programs that you use
$terminal = wezterm
$fileManager = nautilus
$menu = rofi -show drun

# See https://wiki.hypr.land/Configuring/Keywords/
$mainMod = SUPER

# Example binds, see https://wiki.hypr.land/Configuring/Binds/ for more
bind = $mainMod, Return, exec, $terminal
bind = $mainMod, Q, killactive,
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, V, togglefloating,
bind = $mainMod, A, exec , ~/.config/rofi/launchers/type-2/launcher.sh || pkill rofi
bind = $mainMod, Backspace ,exec , ~/.config/hypr/scripts/wlogout.sh
bind = $mainMod, R, exec, ~/.config/hypr/scripts/reload.sh
bind = $mainMod, P, pseudo, # dwindle
bind = $mainMod, J, togglesplit, # dwindle
bind = $mainMod, B, exec, chromium
bind = $mainMod, M, exec, cider
bind = Alt, Return, fullscreen,
bind = $mainMod, F, exec, firefox
bind = $mainMod, C, exec, wezterm -e nvim
bind = SUPER_SHIFT ,F23, exec , easyeffects

# screenshot
#partial
bind =, Print, exec, sh -c 'REGION=$(slurp) || exit; grim -g "$REGION" ~/Media/Pictures/screenshots/Screenshot-$(date +%F_%T).png && dunstify "Region screenshot saved" -t 1000'
#full_screen
bind = SHIFT, Print, exec, grim - | wl-copy && wl-paste > ~/Media/Pictures/screenshots/Screenshot-$(date +%F_%T).png && dunstify "Screenshot of the whole screen taken" -t 1000

# Move focus with mainMod + arrow keys
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d

# Switch workspaces with mainMod+ [0-9]
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

# Move active window to a workspace with mainMod + SHIFT + [0-9]
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Example special workspace (scratchpad)
bind = $mainMod, S, togglespecialworkspace, magic
bind = $mainMod SHIFT, S, movetoworkspace, special:magic

# Scroll through existing workspaces with mainMod + scroll
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# Laptop multimedia keys for volume and LCD brightness
bindel = ,XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = ,XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = ,XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = ,XF86MonBrightnessUp, exec, brightnessctl -e4 -n2 set 5%+
bindel = ,XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 5%-

# Requires playerctl
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPrev, exec, playerctl previous

#resize active window
bindde = $mainMod Shift, Right, $d resize window right , resizeactive, 10 0
bindde = $mainMod Shift, Left, $d resize window left, resizeactive, -10 0
bindde = $mainMod Shift, Up, $d resize window up, resizeactive, 0 -10
bindde = $mainMod Shift, Down, $d resize  window down, resizeactive, 0 10


### AUTOSTART ###
exec-once = swww-daemon 
exec-once = sleep 1 && waybar &  
exec-once = sleep 2 && nm-applet --indicator
exec-once = sleep 3 && mako
exec-once = sleep 5 && rog-control-center  
exec-once = sleep 7 && /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = gnome-keyring-daemon --start --components=secrets
exec-once = systemctl --user start hyprland-session.target
