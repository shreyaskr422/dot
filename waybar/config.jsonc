{
	"layer": "top",
	"position": "top",
	"modules-left": [
		"ext/workspaces",
		"cffi/mediaplayer"
		/*"hyprland/workspaces"*/
		/*"temperature",*/
	],
	"modules-center": [
		"clock"
	],
	"modules-right": [
		"custom/docker",
		"pulseaudio",
		"backlight",
		"battery",
		"tray"
		/*"custom/power"
		"custom/easyeffects",
		"custom/lock",
		"power-profiles-daemon",
		"custom/weather",
		"custom/notification"
		"custom/uptime"
		"network",*/
	],
	"ext/workspaces": {
		"format": "{name} {icon}",
		"format-icons": {
			"active": "󰣇",
			"default": ""
		}
	},
	"tray": {
		"icon-size": 16,
		"spacing": 20
	},
	"clock": {
		"timezone": "Asia/Kolkata",
		"format": "{:%I:%M %p}",
		"tooltip-format": "{:%A, %d %B %Y}",
		"interval": 1
	},
	"battery": {
		"states": {
			"good": 80,
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}",
		"format-charging": "{capacity}",
		"format-plugged": "{capacity}",
		"format-alt": "{time} {icon}",
		"format-full": " {capacity}",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		]
	},
	"backlight": {
		"device": "nvidia_wmi_ec_backlight",
		"format": "{icon}",
		"format-alt": "{percent}   {icon}",
		"tooltip-format": "{percent} %  {icon}",
		"format-icons": [
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			""
		],
		"on-scroll-up": "brightnessctl s 1%+",
		"on-scroll-down": "brightnessctl s 1%-",
		"on-click-right": "brightnessctl s 0",
		"on-click-middle": "mode"
	},
	"pulseaudio": {
		"format": "{icon}",
		"format-alt": "{icon} {volume}",
		"tooltip-format": "{volume} | {desc}",
		"format-muted": " Muted",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": [
				"",
				"",
				""
			]
		},
		"on-click": "pavucontrol",
		"on-click-middle": "mode"
	},
	"custom/docker": {
		"format": "{}",
		"return-type": "json",
		"interval": 10,
		"exec": "$HOME/.config/waybar/scripts/docker-stats/docker-stats",
		"tooltip": true
	},
	"cffi/mediaplayer": {
		"module_path": "/home/moon/.config/waybar/scripts/media-stats/build/waybar_mediaplayer.so",
		"scroll-title": true,
		"scroll-interval": 200,
		"scroll-before-timeout": 5,
		"title-max-width": 200,
		"scroll-step": 2,
		"tooltip": true,
		"tooltip-image-width": 300,
		"tooltip-image-height": 300,
		"btn-play-icon": "",
		"btn-pause-icon": "",
		"btn-prev-icon": "",
		"btn-next-icon": "",
		"ignored-players": "playerctl"
	}
	/*"hyprland/workspaces": {
		"format": "{name}  {icon}",
		"format-icons": {
			"active": "󰣇",
			"default": ""
		}
	},
	"custom/easyeffects": {
		"format": "󰗅",
		"tooltip": false,
		"exec": "pgrep easyeffects && echo on || echo off",
		"interval": 5,
		"on-click": "easyeffects"
	},
	"custom/power": {
		"tooltip": false,
		"on-click": "wlogout &",
		"format": "⏻"
	},
		"power-profiles-daemon": {
		"format": "{icon}",
		"tooltip-format": "Power profile: {profile}\nDriver: {driver}",
		"tooltip": true,
		"format-icons": {
			"default": "",
			"performance": "",
			"balanced": "",
			"power-saver": ""
		}
	},
	"temperature": {
		"thermal-zone": 2,
		"hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
		"critical-threshold": 80,
		"format-critical": "{icon} {temperatureC}°C",
		"format": "{icon} {temperatureC}°C",
		"format-icons": [
			"",
			"",
			""
		]
	},
	/*"custom/weather": {
		"format": "{}",
		"return-type": "json",
		"interval": 300,
		"exec": "$HOME/.config/waybar/scripts/weather-stats/weather-stats",
		"tooltip": true
	}
	"custom/notification": {
		"tooltip": true,
		"format": "<span size='16pt'>{icon}</span>",
		"format-icons": {
			"notification": "󱅫",
			"none": "󰂜",
			"dnd-notification": "󰂠",
			"dnd-none": "󰪓",
			"inhibited-notification": "󰂛",
			"inhibited-none": "󰪑",
			"dnd-inhibited-notification": "󰂛",
			"dnd-inhibited-none": "󰪑"
		},
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	}
	"network": {
		"format-wifi": " 󰤢 ",
		"format-ethernet": " 󰈀 ",
		"format-disconnected": "󰤠 ",
		"interval": 5,
		"tooltip": true,
		"on-click": "nm-connection-editor"
	},
	"custom/uptime": {
		"format": "{}",
		"interval": 1600,
		"exec": "sh -c '(uptime -p)'"
	},*/
}
